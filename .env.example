# Copy this file to .env (cp .env.example .env) and change the values.
# .env is git-ignored - never commit real secrets.

DB_NAME=moviejournal
DB_USERNAME=moviejournal
DB_PASSWORD=change-me

# Must be at least 32 characters (256 bits) for HMAC-SHA256.
# Generate a strong one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
